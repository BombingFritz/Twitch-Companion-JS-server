# Twitch-App-Client-ID aus der Developer Console.
CLIENT_ID=<CLIENT_ID>

# Twitch-App-Client-Secret (sensibel, nie committen oder teilen).
CLIENT_SECRET=<CLIENT_SECRET>

# Muss exakt der Redirect-URI in der Twitch Developer Console entsprechen.
REDIRECT_URI=http://localhost:3000/callback

# Port des Servers (Standard 3000).
PORT=3000

# OAuth-Scopes, durch Leerzeichen getrennt ('+' wird beim Login in Leerzeichen umgewandelt).
SCOPES=user:read:email chat:read channel:read:subscriptions moderator:read:followers user:read:blocked_users user:read:follows channel:read:polls channel:read:predictions moderator:read:shoutouts moderator:manage:shoutouts user:read:chat user:read:emotes user:write:chat channel:read:goals

# Home-Assistant-Webhook für Effekte (optional, ohne Wert kein Versand, Events werden trotzdem geloggt).
HA_WEBHOOK_URL=http://<HA_HOST>/api/webhook/<WEBHOOK_ID>
