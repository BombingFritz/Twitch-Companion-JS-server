# .env.example – Vorlage für die Umgebungsvariablen des Twitch Companion JS server.
# Enthält KEINE echten Zugangsdaten. Kopieren nach ".env" und dort die echten
# Werte eintragen. Die ".env" selbst nie committen oder im Klartext teilen.

# ── Twitch App Credentials (aus der Twitch Developer Console) ──
# Sensibel! Niemals im Klartext dokumentieren oder teilen.
CLIENT_ID=<CLIENT_ID>
CLIENT_SECRET=<CLIENT_SECRET>

# ── OAuth Redirect ──
# Muss exakt der Redirect-URI in der Twitch Developer Console entsprechen.
REDIRECT_URI=http://localhost:3000/callback

# ── Server-Port (Standard 3000) ──
PORT=3000

# ── Twitch OAuth Scopes ──
# Durch Leerzeichen getrennt ('+' wird beim Login in Leerzeichen umgewandelt).
#   user:read:email                 - Basisinfo, oft Standard-Scope
#   chat:read                       - Chat mitlesen
#   channel:read:subscriptions      - Sub-Events / Sub-Goal-Counter
#   moderator:read:followers        - Follow-Events (channel.follow v2)
#   user:read:blocked_users         - Blocklist lesen
#   user:read:follows               - eigene Follows lesen
#   channel:read:polls              - Umfragen lesen
#   channel:read:predictions        - Predictions-Widget
#   moderator:read:shoutouts        - Shoutout-Status lesen
#   moderator:manage:shoutouts      - Shoutouts SENDEN (Kernfeature!)
#   user:read:chat                  - Chat-Nachrichten empfangen (EventSub)
#   user:read:emotes                - Emote-Infos lesen
#   user:write:chat                 - Chat-Nachrichten senden (Raid-Begrüßung, !raidstats, BdU-Chat)
#   channel:read:goals              - Sub-Goal-Counter
SCOPES=user:read:email chat:read channel:read:subscriptions moderator:read:followers user:read:blocked_users user:read:follows channel:read:polls channel:read:predictions moderator:read:shoutouts moderator:manage:shoutouts user:read:chat user:read:emotes user:write:chat channel:read:goals

# ── Home Assistant Webhook-Ziel (optional) ──
# Keine Zugangsdaten, aber eine private Netzwerkadresse: IP/Host und Webhook-ID
# der eigenen Home-Assistant-Instanz eintragen. Nur für die Effekt-Queue
# (scheduleEffect/triggerEffect). Ohne Wert werden Events trotzdem lokal
# geloggt, aber nicht an Home Assistant gesendet.
HA_WEBHOOK_URL=http://<HA_HOST>/api/webhook/<WEBHOOK_ID>

# ── Zugriffsschutz für Widgets (optional) ──
# Erlaubte Browser-Herkünfte (Origin) der Widgets, durch Komma getrennt.
# Leer = Standard: null (Widget per file:///-URL, so werden Widgets in OBS eingebunden)
#        und http://absolute (OBS "Lokale Datei"; neuere OBS-Versionen sperren
#        damit allerdings den Zugriff auf localhost, siehe docs/BUGS.md).
# http://localhost:<PORT> und http://127.0.0.1:<PORT> sind immer erlaubt.
# Notschalter: * erlaubt jede Herkunft (altes Verhalten, unsicher).
CORS_ORIGINS=

# ── UBOAT-Personalakte (optional, ADR 0016) ──
# Saves-Ordner des Spiels UBOAT. Der Server liest daraus nur den neuesten
# Spielstand (Chat-Befehl !personalakte, /api/uboat/crew) und schreibt nie hinein.
# %USERPROFILE% wird aufgelöst. Leer = Funktion aus.
# Beispiel: UBOAT_SAVES_DIR=%USERPROFILE%\AppData\LocalLow\Deep Water Studio\UBOAT\Saves
UBOAT_SAVES_DIR=
